{
  "pipeline": {
    "name": "aria-{{ENV}}",
    "roleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/aria-codepipeline-{{ENV}}",
    "artifactStore": {
      "type": "S3",
      "location": "aria-pipeline-{{ENV}}-{{ACCOUNT_ID}}"
    },
    "stages": [
      {
        "name": "Source",
        "actions": [
          {
            "name": "GitHub",
            "actionTypeId": {
              "category": "Source",
              "owner": "AWS",
              "provider": "CodeStarSourceConnection",
              "version": "1"
            },
            "configuration": {
              "ConnectionArn": "{{GITHUB_CONNECTION_ARN}}",
              "FullRepositoryId": "The-Binary-Holdings/Aria",
              "BranchName": "{{GITHUB_BRANCH}}",
              "OutputArtifactFormat": "CODE_ZIP"
            },
            "outputArtifacts": [{ "name": "SourceOutput" }]
          }
        ]
      },
      {
        "name": "Build",
        "actions": [
          {
            "name": "CodeBuild",
            "actionTypeId": {
              "category": "Build",
              "owner": "AWS",
              "provider": "CodeBuild",
              "version": "1"
            },
            "configuration": {
              "ProjectName": "aria-build-{{ENV}}"
            },
            "inputArtifacts": [{ "name": "SourceOutput" }],
            "outputArtifacts": [{ "name": "BuildOutput" }]
          }
        ]
      },
      {
        "name": "Deploy",
        "actions": [
          {
            "name": "ECS",
            "actionTypeId": {
              "category": "Deploy",
              "owner": "AWS",
              "provider": "ECS",
              "version": "1"
            },
            "configuration": {
              "ClusterName": "aria-{{ENV}}",
              "ServiceName": "aria-web",
              "FileName": "imagedefinitions.json"
            },
            "inputArtifacts": [{ "name": "BuildOutput" }]
          }
        ]
      }
    ]
  }
}
