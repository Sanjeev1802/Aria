{
  "family": "aria-{{ENV}}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/aria-ecs-execution-{{ENV}}",
  "taskRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/aria-ecs-task-{{ENV}}",
  "containerDefinitions": [
    {
      "name": "aria",
      "image": "{{ACCOUNT_ID}}.dkr.ecr.ap-southeast-1.amazonaws.com/aria:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "ANTHROPIC_MODEL_ID", "value": "claude-sonnet-4-6" },
        { "name": "BEDROCK_REGION", "value": "ap-southeast-1" },
        { "name": "BEDROCK_MODEL_ID", "value": "apac.amazon.nova-micro-v1:0" },
        { "name": "BEDROCK_ENABLE_SEARCH", "value": "false" },
        { "name": "NEXT_PUBLIC_COGNITO_REGION", "value": "ap-southeast-1" },
        { "name": "NEXT_PUBLIC_COGNITO_USER_POOL_ID", "value": "{{COGNITO_USER_POOL_ID}}" },
        { "name": "NEXT_PUBLIC_COGNITO_CLIENT_ID", "value": "{{COGNITO_CLIENT_ID}}" },
        { "name": "DB_HOST", "value": "{{DB_HOST}}" },
        { "name": "DB_NAME", "value": "aria" }
      ],
      "secrets": [
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:{{ACCOUNT_ID}}:secret:aria/{{ENV}}/db-master:username::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:{{ACCOUNT_ID}}:secret:aria/{{ENV}}/db-master:password::"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:{{ACCOUNT_ID}}:secret:aria-{{ENV}}:ANTHROPIC_API_KEY::"
        },
        {
          "name": "BEDROCK_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:{{ACCOUNT_ID}}:secret:aria-{{ENV}}:BEDROCK_API_KEY::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/aria-{{ENV}}",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "aria"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 90
      }
    }
  ]
}
