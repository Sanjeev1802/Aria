# =============================================================================
# ARIA environment variables
# =============================================================================
#
# Copy this file to `.env.local` for local development:
#
#   cp .env.example .env.local
#
# Next.js loads `.env.local` automatically. Do not commit real secrets.
# Never put AWS keys, Cognito secrets, or API keys in NEXT_PUBLIC_* variables.
#
# Quick profiles:
#   • Local app + fake model + SQLite ledger  → see "Profile: local development"
#   • UI-only design preview                  → NEXT_PUBLIC_ARIA_PREVIEW=true
#   • Staging / production                    → Cognito + DynamoDB + Bedrock + ARIA_LIVE_CHAT
#
# =============================================================================


# -----------------------------------------------------------------------------
# Profile: local development (recommended to start)
# -----------------------------------------------------------------------------
# Uncomment and use this block in `.env.local` when you are not on AWS yet.
#
# NEXT_PUBLIC_ARIA_PREVIEW=false
# ARIA_LOCAL_DEV=true
# ARIA_LIVE_CHAT=disabled
# AWS_REGION=us-east-1
#
# With ARIA_LOCAL_DEV=true and no ARIA_DYNAMODB_TABLE:
#   • Sign in at http://127.0.0.1:3000/sign-in/ (any email/password in local mode)
#   • Switch users Alex / Blair in the chat sidebar
#   • Ledger persists in .aria/local-dev.sqlite
#   • Chat uses the deterministic test model (not Bedrock)


# -----------------------------------------------------------------------------
# Client — design preview
# -----------------------------------------------------------------------------
# When true, the browser uses scripted replies and skips live API accounting.
# No server configuration required for UI review.

NEXT_PUBLIC_ARIA_PREVIEW=false


# -----------------------------------------------------------------------------
# Identity — Amazon Cognito (required in production)
# -----------------------------------------------------------------------------
# App client flows: ALLOW_USER_PASSWORD_AUTH, ALLOW_REFRESH_TOKEN_AUTH.
# Optional client secret stays server-side only.

ARIA_COGNITO_USER_POOL_ID=
ARIA_COGNITO_CLIENT_ID=
ARIA_COGNITO_CLIENT_SECRET=

# Canonical HTTPS origin for CSRF checks and team invite links (no trailing slash).
# Example: https://aria.example.com
ARIA_APP_ORIGIN=

# Optional OneWave transactional email for Team invitations. Both values are
# server-only. Create the aria-team-invitation template in the email service;
# invite_link must point to this app's ARIA_APP_ORIGIN. Without these values,
# ARIA shows the admin a one-time link for manual sharing.
# Example URL from the aria-api-changes integration: https://dev.send.onewave.live
EMAIL_SERVICE_URL=
EMAIL_SERVICE_API_KEY=


# -----------------------------------------------------------------------------
# Accounts & credit ledger — DynamoDB
# -----------------------------------------------------------------------------
# Table definition: infra/dynamodb-table.json
# Required in production. Omit in local dev to use SQLite instead.

ARIA_DYNAMODB_TABLE=

# Development only — DynamoDB Local or custom endpoint. Ignored when NODE_ENV=production.

ARIA_DYNAMODB_ENDPOINT=


# -----------------------------------------------------------------------------
# Local development identity & storage
# -----------------------------------------------------------------------------
# Loopback-only (127.0.0.1). Ignored in production builds.

ARIA_LOCAL_DEV=false

# Optional path for the development SQLite ledger (default: .aria/local-dev.sqlite)

# ARIA_LOCAL_STORE_PATH=.aria/local-dev.sqlite


# -----------------------------------------------------------------------------
# Chat operator switch
# -----------------------------------------------------------------------------
# Production model calls require identity + ledger + Bedrock rates AND this switch.
# Local dev with ARIA_LOCAL_DEV=true enables chat via the fake model without this.

ARIA_LIVE_CHAT=disabled


# -----------------------------------------------------------------------------
# Models — Amazon Bedrock
# -----------------------------------------------------------------------------
# Credentials: use the AWS SDK default chain (e.g. aws login, SSO, or task role),
# or a Bedrock API key as AWS_BEARER_TOKEN_BEDROCK (server-side only).
# Set the exact Nova model or inference profile ID enabled in your account and region.
# Rates must match that model; ARIA_RATE_VERSION is a label stored on ledger events.

AWS_BEARER_TOKEN_BEDROCK=

AWS_REGION=us-east-1

ARIA_NOVA_MODEL_ID=

ARIA_NOVA_INPUT_USD_PER_MILLION=
ARIA_NOVA_OUTPUT_USD_PER_MILLION=
ARIA_RATE_VERSION=


# -----------------------------------------------------------------------------
# Optional — public web search (SearXNG)
# -----------------------------------------------------------------------------
# When set, entitled users can opt in to explicit web search in chat.
# Server-only base URL of your own SearXNG instance, reachable from the ARIA
# server, with JSON enabled in search.formats; see SEARCH_TOOL_RESEARCH.md.
# Example for local Docker: http://127.0.0.1:8888

ARIA_SEARXNG_URL=

# Optional ElastiCache Serverless (Valkey/Redis OSS) cache for public web-search
# results only. Use the private TLS cluster endpoint and RBAC credentials.
# Keep this unset until the cache is provisioned; ARIA works without it.
# Inject the password from AWS Secrets Manager in production. Never expose it
# through NEXT_PUBLIC_* or commit it to Git.
# ARIA_ELASTICACHE_URL=rediss://aria-search:password@your-cache.serverless.region.cache.amazonaws.com:6379


# -----------------------------------------------------------------------------
# Staging / production checklist (reference)
# -----------------------------------------------------------------------------
# ARIA_COGNITO_USER_POOL_ID=...
# ARIA_COGNITO_CLIENT_ID=...
# ARIA_APP_ORIGIN=https://your-domain.example
# ARIA_DYNAMODB_TABLE=aria-staging
# AWS_REGION=us-east-1
# ARIA_NOVA_MODEL_ID=...
# ARIA_NOVA_*_USD_PER_MILLION=...   (verified for your region)
# ARIA_RATE_VERSION=2026-10-us-east-1
# ARIA_LIVE_CHAT=enabled        (only after staging verification)
