# App origin
NEXT_PUBLIC_WEB_URL=http://localhost:3000
ARIA_PUBLIC_URL=http://localhost:3000
ARIA_EMBED_SECRET=
ARIA_FRAME_ANCESTORS='self' http://localhost:3000 http://127.0.0.1:3000

# AWS Cognito (ap-southeast-1) — public app client, no client secret
NEXT_PUBLIC_COGNITO_REGION=ap-southeast-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Aurora PostgreSQL (server-only) — required for local dashboard/chat APIs
# Run: aws login --region ap-southeast-1 && ./scripts/bootstrap-local-env.sh dev
DATABASE_URL=

# Amazon Bedrock (server-only — never use NEXT_PUBLIC_)
BEDROCK_API_KEY=
BEDROCK_REGION=ap-southeast-1
BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0

# Live web search is not connected yet. Leave false.
BEDROCK_ENABLE_SEARCH=false
