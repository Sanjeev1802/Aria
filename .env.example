# App origin
NEXT_PUBLIC_WEB_URL=http://localhost:3000
ARIA_PUBLIC_URL=http://localhost:3000
ARIA_EMBED_SECRET=
ARIA_FRAME_ANCESTORS='self' http://localhost:3000 http://127.0.0.1:3000

# AWS Cognito (ap-southeast-1) — public app client, no client secret
NEXT_PUBLIC_COGNITO_REGION=ap-southeast-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# PostgreSQL (server-only) — required for dashboard/chat APIs
# Local dev (recommended): npm run db:local  → 127.0.0.1:5432
# Remote Aurora (needs VPN): ./scripts/sync-aria-dev-env.sh after AWS login
USE_LOCAL_DATABASE=true
DATABASE_URL=postgresql://aria:aria@127.0.0.1:5432/aria

# Anthropic (server-only — preferred when set)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-6

# Amazon Bedrock (server-only fallback when ANTHROPIC_API_KEY is unset)
BEDROCK_API_KEY=
BEDROCK_REGION=ap-southeast-1
BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0

# Live web search is not connected yet. Leave false.
BEDROCK_ENABLE_SEARCH=false
