# Explicit offline UI preview, with scripted responses and no charge:
NEXT_PUBLIC_ARIA_PREVIEW=false

# --- Identity (Amazon Cognito) ---------------------------------------------
# App client must allow USER_PASSWORD_AUTH and REFRESH_TOKEN_AUTH.
ARIA_COGNITO_USER_POOL_ID=
ARIA_COGNITO_CLIENT_ID=
# Optional confidential-client secret. Server-only; never NEXT_PUBLIC_.
ARIA_COGNITO_CLIENT_SECRET=
# Canonical public origin used for CSRF checks and invite links. Required in production.
ARIA_APP_ORIGIN=

# --- Shared ledger + accounts (DynamoDB) -------------------------------------
# Table layout: infra/dynamodb-table.json. Required in production.
ARIA_DYNAMODB_TABLE=
# Development only, e.g. http://localhost:8000 for DynamoDB Local. Ignored in production.
ARIA_DYNAMODB_ENDPOINT=

# --- Chat switch -------------------------------------------------------------
# Production chat stays off until identity + accounting are verified together in staging.
ARIA_LIVE_CHAT=disabled
# Development only: loopback local users (Alex / Blair), no Cognito needed. Ignored in production.
# Without ARIA_DYNAMODB_TABLE the server uses a persistent SQLite ledger at .aria/local-dev.sqlite.
ARIA_LOCAL_DEV=false
# Optional override for the development SQLite file path.
# ARIA_LOCAL_STORE_PATH=.aria/local-dev.sqlite

# --- Bedrock -------------------------------------------------------------------
AWS_REGION=us-east-1
# Use AWS CLI SSO / SDK default credential chain; never NEXT_PUBLIC_ AWS secrets.
# Set the exact model or inference profile IDs enabled for your account and region.
ARIA_NOVA_MODEL_ID=
ARIA_CLAUDE_MODEL_ID=
# Set verified USD / million token rates for those exact models and region.
ARIA_NOVA_INPUT_USD_PER_MILLION=
ARIA_NOVA_OUTPUT_USD_PER_MILLION=
ARIA_CLAUDE_INPUT_USD_PER_MILLION=
ARIA_CLAUDE_OUTPUT_USD_PER_MILLION=
ARIA_RATE_VERSION=
