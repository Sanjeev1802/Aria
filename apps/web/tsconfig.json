{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@aria/auth": ["../../packages/auth/src"],
      "@aria/auth/*": ["../../packages/auth/src/*"],
      "@aria/ui": ["../../packages/ui/src"],
      "@aria/ui/*": ["../../packages/ui/src/*"],
      "@aria/utils": ["../../packages/utils/src"],
      "@aria/utils/*": ["../../packages/utils/src/*"],
      "@aria/types": ["../../packages/types/src"],
      "@aria/types/*": ["../../packages/types/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
