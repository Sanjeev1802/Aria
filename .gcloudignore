# Used by `gcloud run deploy --source` / Cloud Build uploads.
# Unlike .gitignore, we KEEP .env.production so NEXT_PUBLIC_* exist at build time.

.next
node_modules
.git
.gitignore
README.md
*.md
.DS_Store
.vscode
.idea
coverage
.vercel

# Local secrets — never upload
.env.local
.env*.local
.env
.env.development
.env.test

# Allow .env.production (public Firebase web config only)
!.env.production
